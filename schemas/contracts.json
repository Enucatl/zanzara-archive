{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zanzara-archive.local/schemas/contracts.json",
  "title": "Zanzara Archive contracts",
  "description": "Versioned shapes for typed records and /api/v1 envelopes. Model output is never implied by this schema.",
  "$defs": {
    "ApiError": {
      "type": "object",
      "required": ["code", "message", "retryable", "request_id"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "retryable": {"type": "boolean"},
        "request_id": {"type": "string"}
      },
      "additionalProperties": false
    },
    "ApiEnvelope": {
      "type": "object",
      "required": ["request_id", "status"],
      "properties": {
        "request_id": {"type": "string"},
        "status": {"enum": ["ok", "error"]},
        "data": {"type": "object"},
        "error": {"$ref": "#/$defs/ApiError"}
      },
      "additionalProperties": false
    },
    "AudioArtifact": {
      "type": "object",
      "required": ["artifact_id", "source_sha256", "format", "duration_ms", "sample_rate_hz", "channels", "time_origin_ms", "transform_hash", "decoder_version", "preprocessing"],
      "properties": {
        "artifact_id": {"type": "string"},
        "source_sha256": {"$ref": "#/$defs/Sha256"},
        "format": {"type": "string"},
        "duration_ms": {"type": "integer", "exclusiveMinimum": 0},
        "sample_rate_hz": {"type": "integer", "exclusiveMinimum": 0},
        "channels": {"type": "integer", "exclusiveMinimum": 0},
        "time_origin_ms": {"type": "integer", "minimum": 0},
        "transform_hash": {"anyOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]},
        "decoder_version": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "preprocessing": {"type": "object"}
      },
      "additionalProperties": false
    },
    "ModelFingerprint": {
      "type": "object",
      "required": ["name", "repository", "revision", "checkpoint_sha256", "dimensions", "preprocessing", "precision", "runtime", "terms_evidence"],
      "properties": {
        "name": {"type": "string"},
        "repository": {"type": "string"},
        "revision": {"type": "string"},
        "checkpoint_sha256": {"type": "array", "items": {"$ref": "#/$defs/Sha256"}, "minItems": 1},
        "dimensions": {"anyOf": [{"type": "integer", "exclusiveMinimum": 0}, {"type": "null"}]},
        "preprocessing": {"type": "object"},
        "precision": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "runtime": {"type": "object", "additionalProperties": {"type": "string"}},
        "terms_evidence": {"anyOf": [{"type": "string"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "TimedWord": {
      "type": "object",
      "required": ["word_id", "text", "start_ms", "end_ms", "confidence", "speaker_id", "overlap"],
      "properties": {
        "word_id": {"type": "string"},
        "text": {"type": "string"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "exclusiveMinimum": 0},
        "confidence": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "null"}]},
        "speaker_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "overlap": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "Turn": {
      "type": "object",
      "required": ["speaker_id", "start_ms", "end_ms", "confidence"],
      "properties": {
        "speaker_id": {"type": "string"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "exclusiveMinimum": 0},
        "confidence": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "Overlap": {
      "type": "object",
      "required": ["speaker_ids", "start_ms", "end_ms"],
      "properties": {
        "speaker_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "SpeakerStream": {
      "type": "object",
      "required": ["speaker_id", "turns"],
      "properties": {
        "speaker_id": {"type": "string"},
        "turns": {"type": "array", "items": {"$ref": "#/$defs/Turn"}}
      },
      "additionalProperties": false
    },
    "SpeakerConditionMetadata": {
      "type": "object",
      "required": ["version", "threshold_version", "speaker_ids", "speaker_count", "max_simultaneous_speakers", "speech_ms", "overlap_ms", "overlap_fraction", "has_overlap", "speaker_condition", "status", "origin", "diarization_fingerprint", "diarization_artifact_id"],
      "properties": {
        "version": {"type": "string"},
        "threshold_version": {"type": "string"},
        "speaker_ids": {"type": "array", "items": {"type": "string"}},
        "speaker_count": {"type": "integer", "minimum": 0},
        "max_simultaneous_speakers": {"type": "integer", "minimum": 0},
        "speech_ms": {"type": "integer", "minimum": 0},
        "overlap_ms": {"type": "integer", "minimum": 0},
        "overlap_fraction": {"anyOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "null"}]},
        "has_overlap": {"type": "boolean"},
        "speaker_condition": {"enum": ["single_speaker", "multi_speaker_no_overlap", "partial_overlap", "heavy_overlap", "uncertain"]},
        "status": {"enum": ["derived", "unknown"]},
        "origin": {"enum": ["machine_seed", "human_review"]},
        "diarization_fingerprint": {"anyOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]},
        "diarization_artifact_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "SpeakerConditionCorrection": {
      "type": "object",
      "required": ["metadata", "reviewer", "reviewed_at", "reason", "seed_version"],
      "properties": {
        "metadata": {"$ref": "#/$defs/SpeakerConditionMetadata"},
        "reviewer": {"type": "string"},
        "reviewed_at": {"type": "string"},
        "reason": {"type": "string"},
        "seed_version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "AudioSetScore": {
      "type": "object",
      "required": ["class_id", "label", "probability"],
      "properties": {
        "class_id": {"type": "integer", "minimum": 0},
        "label": {"type": "string"},
        "probability": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "AudioSetWindowScores": {
      "type": "object",
      "required": ["start_ms", "end_ms", "scores"],
      "properties": {
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "exclusiveMinimum": 0},
        "scores": {"type": "array", "items": {"$ref": "#/$defs/AudioSetScore"}}
      },
      "additionalProperties": false
    },
    "SignalMeasurements": {
      "type": "object",
      "required": ["clipping_fraction", "peak_dbfs", "rms_dbfs", "silence_fraction"],
      "properties": {
        "clipping_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "peak_dbfs": {"type": "number"},
        "rms_dbfs": {"type": "number"},
        "silence_fraction": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "AcousticConditionMetadata": {
      "type": "object",
      "required": ["version", "threshold_version", "has_music", "music_level", "has_speech", "non_speech_activity", "audio_quality", "signal_measurements", "raw_scores", "window_scores", "music_score", "speech_score", "status", "origin", "model_fingerprint", "label_map_sha256", "preprocessing_sha256"],
      "properties": {
        "version": {"type": "string"},
        "threshold_version": {"type": "string"},
        "has_music": {"type": "boolean"},
        "music_level": {"enum": ["none", "background", "dominant", "uncertain"]},
        "has_speech": {"type": "boolean"},
        "non_speech_activity": {"type": "array", "items": {"type": "string"}},
        "audio_quality": {"enum": ["clean", "degraded", "uncertain"]},
        "signal_measurements": {"$ref": "#/$defs/SignalMeasurements"},
        "raw_scores": {"type": "array", "items": {"$ref": "#/$defs/AudioSetScore"}},
        "window_scores": {"type": "array", "items": {"$ref": "#/$defs/AudioSetWindowScores"}},
        "music_score": {"type": "number", "minimum": 0, "maximum": 1},
        "speech_score": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["derived", "unknown"]},
        "origin": {"enum": ["machine_seed", "human_review"]},
        "model_fingerprint": {"anyOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]},
        "label_map_sha256": {"anyOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]},
        "preprocessing_sha256": {"anyOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "AcousticConditionCorrection": {
      "type": "object",
      "required": ["music_level", "audio_quality", "reviewer", "reviewed_at", "reason", "seed_version"],
      "properties": {
        "music_level": {"enum": ["none", "background", "dominant", "uncertain"]},
        "audio_quality": {"enum": ["clean", "degraded", "uncertain"]},
        "reviewer": {"type": "string"},
        "reviewed_at": {"type": "string"},
        "reason": {"type": "string"},
        "seed_version": {"type": "string"}
      },
      "additionalProperties": false
    },
    "ChunkCondition": {
      "type": "object",
      "required": ["speaker_streams", "overlaps", "acoustic_labels", "rapid_turn_taking", "music", "degraded"],
      "properties": {
        "speaker_streams": {"type": "array", "items": {"$ref": "#/$defs/SpeakerStream"}},
        "overlaps": {"type": "array", "items": {"$ref": "#/$defs/Overlap"}},
        "acoustic_labels": {"type": "array", "items": {"type": "string"}},
        "rapid_turn_taking": {"type": "boolean"},
        "music": {"type": "boolean"},
        "degraded": {"type": "boolean"},
        "exclusive_speaker_streams": {"type": "array", "items": {"$ref": "#/$defs/SpeakerStream"}},
        "speaker_metadata": {"anyOf": [{"$ref": "#/$defs/SpeakerConditionMetadata"}, {"type": "null"}]},
        "speaker_correction": {"anyOf": [{"$ref": "#/$defs/SpeakerConditionCorrection"}, {"type": "null"}]},
        "acoustic_metadata": {"anyOf": [{"$ref": "#/$defs/AcousticConditionMetadata"}, {"type": "null"}]},
        "acoustic_correction": {"anyOf": [{"$ref": "#/$defs/AcousticConditionCorrection"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "AudioChunk": {
      "type": "object",
      "required": ["chunk_id", "episode_id", "source_sha256", "start_ms", "end_ms", "segmentation_fingerprint", "duration_ms", "condition", "partition"],
      "properties": {
        "chunk_id": {"type": "string"},
        "episode_id": {"type": "string"},
        "source_sha256": {"$ref": "#/$defs/Sha256"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "exclusiveMinimum": 0},
        "segmentation_fingerprint": {"$ref": "#/$defs/Sha256"},
        "duration_ms": {"anyOf": [{"type": "integer", "exclusiveMinimum": 0}, {"type": "null"}]},
        "condition": {"anyOf": [{"$ref": "#/$defs/ChunkCondition"}, {"type": "null"}]},
        "partition": {"anyOf": [{"enum": ["development", "held_out"]}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "TranscriptionHypothesis": {
      "type": "object",
      "required": ["hypothesis_id", "chunk_id", "model_fingerprint_sha256", "text", "words", "segments", "raw_metadata", "timestamp_granularities", "source_sha256", "artifact_id"],
      "properties": {
        "hypothesis_id": {"type": "string"},
        "chunk_id": {"type": "string"},
        "model_fingerprint": {"anyOf": [{"$ref": "#/$defs/ModelFingerprint"}, {"type": "string"}, {"type": "null"}]},
        "model_fingerprint_sha256": {"$ref": "#/$defs/Sha256"},
        "text": {"type": "string"},
        "words": {"type": "array", "items": {"$ref": "#/$defs/TimedWord"}},
        "segments": {"type": "array", "items": {"type": "object"}},
        "raw_metadata": {"type": "object"},
        "timestamp_granularities": {"type": "array", "items": {"enum": ["word", "segment"]}},
        "source_sha256": {"anyOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]},
        "artifact_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "TranscriptReference": {
      "type": "object",
      "required": ["reference_id", "chunk_id", "source_sha256", "text", "speaker_streams", "review_status", "revision", "reviewer", "created_at"],
      "properties": {
        "reference_id": {"type": "string"},
        "chunk_id": {"type": "string"},
        "source_sha256": {"$ref": "#/$defs/Sha256"},
        "text": {"type": "string"},
        "speaker_streams": {"type": "array", "items": {"$ref": "#/$defs/SpeakerStream"}},
        "review_status": {"enum": ["draft", "human_truth", "superseded", "rejected"]},
        "revision": {"type": "integer", "exclusiveMinimum": 0},
        "reviewer": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "created_at": {"anyOf": [{"type": "string"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "ReferenceRevision": {
      "type": "object",
      "required": ["revision_id", "reference_id", "chunk_id", "revision", "reviewer", "source_sha256", "prior_revision_id", "review_status", "text", "speaker_streams", "created_at"],
      "properties": {
        "revision_id": {"type": "string"},
        "reference_id": {"type": "string"},
        "chunk_id": {"type": "string"},
        "revision": {"type": "integer", "exclusiveMinimum": 0},
        "reviewer": {"type": "string"},
        "source_sha256": {"$ref": "#/$defs/Sha256"},
        "prior_revision_id": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "review_status": {"enum": ["draft", "human_truth", "superseded", "rejected"]},
        "text": {"type": "string"},
        "speaker_streams": {"type": "array", "items": {"$ref": "#/$defs/SpeakerStream"}},
        "created_at": {"anyOf": [{"type": "string"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "ChunkBenchmarkManifest": {
      "type": "object",
      "required": ["manifest_id", "schema_version", "source_manifest_sha256", "source_hashes", "chunks", "references", "hypotheses", "partitions"],
      "properties": {
        "manifest_id": {"type": "string"},
        "schema_version": {"type": "integer", "exclusiveMinimum": 0},
        "source_manifest_sha256": {"anyOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]},
        "source_hashes": {"type": "array", "items": {"$ref": "#/$defs/Sha256"}},
        "chunks": {"type": "array", "items": {"$ref": "#/$defs/AudioChunk"}, "minItems": 1},
        "references": {"type": "array", "items": {"$ref": "#/$defs/TranscriptReference"}},
        "hypotheses": {"type": "array", "items": {"$ref": "#/$defs/TranscriptionHypothesis"}},
        "partitions": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "segmentation_version": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "segmentation_configuration": {"type": "object"},
        "segmentation_input_fingerprints": {"type": "array", "items": {"$ref": "#/$defs/Sha256"}}
      },
      "additionalProperties": false
    },
    "TranscriptResult": {
      "type": "object",
      "required": ["artifact_id", "source_sha256", "model", "text", "words", "segments", "status", "timestamp_granularities", "request_id", "duration_ms"],
      "properties": {
        "artifact_id": {"type": "string"},
        "source_sha256": {"$ref": "#/$defs/Sha256"},
        "model": {"$ref": "#/$defs/ModelFingerprint"},
        "text": {"type": "string"},
        "words": {"type": "array", "items": {"$ref": "#/$defs/TimedWord"}},
        "segments": {"type": "array", "items": {"type": "object"}},
        "status": {"enum": ["timed", "text_only", "no_words", "missing_asr"]},
        "timestamp_granularities": {"type": "array", "items": {"enum": ["word", "segment"]}},
        "request_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}
        ,"duration_ms": {"anyOf": [{"type": "integer", "exclusiveMinimum": 0}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "EmbeddingBatch": {
      "type": "object",
      "required": ["model", "item_ids", "vectors", "request_id"],
      "properties": {
        "model": {"$ref": "#/$defs/ModelFingerprint"},
        "item_ids": {"type": "array", "items": {"type": "string"}},
        "vectors": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
        "request_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "DiarizationResult": {
      "type": "object",
      "required": ["artifact_id", "source_sha256", "duration_ms", "model", "standard_turns", "exclusive_turns", "overlaps", "request_id"],
      "properties": {
        "artifact_id": {"type": "string"},
        "source_sha256": {"$ref": "#/$defs/Sha256"},
        "duration_ms": {"type": "integer", "exclusiveMinimum": 0},
        "model": {"$ref": "#/$defs/ModelFingerprint"},
        "standard_turns": {"type": "array", "items": {"$ref": "#/$defs/Turn"}},
        "exclusive_turns": {"type": "array", "items": {"$ref": "#/$defs/Turn"}},
        "overlaps": {"type": "array", "items": {"$ref": "#/$defs/Overlap"}},
        "request_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "ArtifactManifest": {
      "type": "object",
      "required": ["artifact_id", "source_sha256", "stage", "stage_key", "upstream_artifact_hashes", "file_checksums", "pipeline_version", "schema_version", "model_fingerprint_sha256"],
      "properties": {
        "artifact_id": {"type": "string"},
        "source_sha256": {"$ref": "#/$defs/Sha256"},
        "stage": {"type": "string"},
        "stage_key": {"type": "string"},
        "upstream_artifact_hashes": {"type": "array", "items": {"$ref": "#/$defs/Sha256"}},
        "file_checksums": {"type": "object", "additionalProperties": {"$ref": "#/$defs/Sha256"}},
        "pipeline_version": {"type": "string"},
        "schema_version": {"type": "integer", "exclusiveMinimum": 0},
        "model_fingerprint_sha256": {"anyOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "JobStatus": {
      "type": "object",
      "required": ["job_id", "stage", "status", "attempts", "fencing_token", "owner", "lease_expires_at", "error", "recovery_action", "request_id"],
      "properties": {
        "job_id": {"type": "string"},
        "stage": {"type": "string"},
        "status": {"enum": ["queued", "running", "retry_wait", "succeeded", "failed", "cancelled", "blocked"]},
        "attempts": {"type": "integer", "minimum": 0},
        "fencing_token": {"type": "integer", "minimum": 0},
        "owner": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "lease_expires_at": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "error": {"anyOf": [{"$ref": "#/$defs/ApiError"}, {"type": "null"}]},
        "recovery_action": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "request_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "CandidateScore": {
      "type": "object",
      "required": ["candidate_id", "episode_speaker_id", "rank", "score", "model_scores", "calibration_status", "calibration_artifact_sha256", "provenance_artifact_ids"],
      "properties": {
        "candidate_id": {"type": "string"},
        "episode_speaker_id": {"type": "string"},
        "rank": {"type": "integer", "exclusiveMinimum": 0},
        "score": {"type": "number"},
        "model_scores": {"type": "object", "additionalProperties": {"type": "number"}},
        "calibration_status": {"enum": ["uncalibrated_rank_fusion", "calibrated_estimate", "unavailable"]},
        "calibration_artifact_sha256": {"anyOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]},
        "provenance_artifact_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "IdentityDecision": {
      "type": "object",
      "required": ["decision_id", "left_episode_speaker_id", "right_episode_speaker_id", "decision", "reviewer", "evidence_artifact_ids", "created_at", "state", "revision"],
      "properties": {
        "decision_id": {"type": "string"},
        "left_episode_speaker_id": {"type": "string"},
        "right_episode_speaker_id": {"type": "string"},
        "decision": {"enum": ["same_person", "different_person", "uncertain"]},
        "reviewer": {"type": "string"},
        "evidence_artifact_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "created_at": {"type": "string"},
        "state": {"enum": ["active", "superseded"]},
        "revision": {"type": "integer", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "EvaluationReport": {
      "type": "object",
      "required": ["report_id", "source_sha256", "split_sha256", "model_fingerprint_sha256", "configuration_sha256", "reviewed_commit", "verdict", "metrics", "limitations", "generated_at"],
      "properties": {
        "report_id": {"type": "string"},
        "source_sha256": {"$ref": "#/$defs/Sha256"},
        "split_sha256": {"$ref": "#/$defs/Sha256"},
        "model_fingerprint_sha256": {"type": "array", "items": {"$ref": "#/$defs/Sha256"}, "minItems": 1},
        "configuration_sha256": {"$ref": "#/$defs/Sha256"},
        "reviewed_commit": {"type": "string"},
        "verdict": {"enum": ["pass", "blocked", "insufficient_evidence"]},
        "metrics": {"type": "object"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "generated_at": {"anyOf": [{"type": "string"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "Sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "service_routes": {
    "GET /health": {"response": {"$ref": "#/$defs/ApiEnvelope"}},
    "GET /ready": {"response": {"$ref": "#/$defs/ApiEnvelope"}},
    "POST /v1/audio/transcriptions": {"response": {"$ref": "#/$defs/ApiEnvelope"}},
    "POST /v1/diarize": {"response": {"$ref": "#/$defs/ApiEnvelope"}},
    "POST /v1/embed-speakers": {"response": {"$ref": "#/$defs/ApiEnvelope"}},
    "POST /v1/embeddings": {"response": {"$ref": "#/$defs/ApiEnvelope"}}
  },
  "routes": {
    "GET /api/v1/annotations/{episode_id}": {"response": {"$ref": "#/$defs/ApiEnvelope"}},
    "POST /api/v1/annotations/{episode_id}": {"response": {"$ref": "#/$defs/ApiEnvelope"}},
    "POST /api/v1/annotations/{episode_id}/seed": {"response": {"$ref": "#/$defs/ApiEnvelope"}},
    "GET /api/v1/annotations/{episode_id}/exports/{revision}/{filename}": {"response": {"$ref": "#/$defs/ApiEnvelope"}},
    "GET /api/v1/episodes/{id}/transcript": {"response": {"$ref": "#/$defs/ApiEnvelope"}, "missing_asr_status": "missing_asr"},
    "POST /api/v1/voice-search/jobs": {"response": {"$ref": "#/$defs/ApiEnvelope"}, "calibration_status": "uncalibrated_rank_fusion"},
    "GET /api/v1/jobs/{id}": {"response": {"$ref": "#/$defs/ApiEnvelope"}},
    "GET /api/v1/health": {"response": {"$ref": "#/$defs/ApiEnvelope"}},
